% El bucle de integracion, con el mismo dibujo que el del TP4: que hace
% Simulation::simulate() en cada paso, en el orden en que lo hace. El paso es
% dt = dt_exp / n con n entero: cada n pasos cae un instante experimental, y
% ahi se guarda el estado que despues se compara con la medicion, sin
% interpolar.
\begin{tikzpicture}[
    font=\small,
    paso/.style={draw=azul!55, fill=azul!6, rounded corners=2pt, align=left,
                 inner sep=5pt, text width=124mm},
    fl/.style={-{Stealth[length=2mm]}, azul, thick}]
    \node[paso, fill=grisclaro, draw=gris!60] (e0)
        {Arranque: $\vr(0)$ y $\vv(0)$ medidas en el evento, y $\vF(0)$};
    \node[paso, below=2.0mm of e0] (p1)
        {\textbf{1.} Predictor de Beeman: $\vr(t{+}\dt)$ y $\vv$ predicha};
    \node[paso, below=2.0mm of p1] (p2)
        {\textbf{2.} {\color{acento}\bfseries Capa de elusión}: el target temporal $\vT_i^{*}$ de cada agente};
    \node[paso, below=2.0mm of p2] (p3)
        {\textbf{3.} Sumar $\vF$ del SFM: conducción hacia $\vT_i^{*}$ y contacto};
    \node[paso, below=2.0mm of p3] (p4)
        {\textbf{4.} Corrector de Beeman: $\vv(t{+}\dt)$};
    \node[paso, below=2.0mm of p4] (p5)
        {\textbf{5.} Otra vez la capa y $\vF$, con el estado corregido: $\vF(t{+}\dt)$};
    \node[paso, below=2.0mm of p5, fill=grisclaro, draw=gris!60] (p6)
        {\textbf{6.} Cada $\dtexp = n\,\dt$: guardar el estado};
    \node[paso, below=2.0mm of p6, fill=grisclaro, draw=gris!60] (fin)
        {Al terminar el último instante: $\Euno$ y $\Edos$ contra la trayectoria medida};
    \draw[fl] (e0) -- (p1);
    \draw[fl] (p1) -- (p2);
    \draw[fl] (p2) -- (p3);
    \draw[fl] (p3) -- (p4);
    \draw[fl] (p4) -- (p5);
    \draw[fl] (p5) -- (p6);
    \draw[fl] (p6) -- (fin);
    \draw[fl, gris] (p6.east) -- ++(6mm,0) |- ($(p1.east)+(6mm,0)$) -- (p1.east);
\end{tikzpicture}%
