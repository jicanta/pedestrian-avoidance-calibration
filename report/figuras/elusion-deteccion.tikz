% Capa de elusion, paso 1: deteccion del conflicto por extrapolacion lineal.
% Con Dr = r_j - r_i y Dv = v_j - v_i, el instante de minima aproximacion es
% tau* = -(Dr . Dv)/|Dv|^2 y la separacion predicha ahi, d* = |Dr + Dv tau*|.
% Hay conflicto si 0 < tau* <= ta y d* < D = r_i + r_j + ds.
\begin{tikzpicture}[scale=1.0, >={Stealth[length=2.4mm]}, font=\footnotesize]
  \coordinate (ri) at (0,0);
  \coordinate (rj) at (7.0,1.9);
  \coordinate (pi) at (3.3,0.62);
  \coordinate (pj) at (3.9,1.42);

  % Extrapolacion lineal de las dos trayectorias
  \draw[izquierda, dashed] (ri) -- (5.6,1.05);
  \draw[derecha,   dashed] (rj) -- (1.9,1.07);

  % Posiciones actuales
  \fill[izquierda] (ri) circle (0.25);
  \fill[derecha]   (rj) circle (0.25);
  \node[izquierda, anchor=north] at ($(ri)+(0,-0.32)$) {$i$};
  \node[derecha,   anchor=south] at ($(rj)+(0,0.32)$) {$j$};

  % Velocidades
  \draw[izquierda, very thick, ->] (ri) -- ++(1.35,0.26);
  \draw[derecha,   very thick, ->] (rj) -- ++(-1.35,-0.24);

  % Discos predichos al instante de minima aproximacion
  \draw[izquierda, thick, dashed, fill=izquierda!12] (pi) circle (0.25);
  \draw[derecha,   thick, dashed, fill=derecha!12]   (pj) circle (0.25);
  \node[gris, anchor=north west, inner sep=2pt] at ($(pi)+(0.35,-0.05)$)
        {donde estarían en \tdca};

  % Separacion predicha
  \draw[<->, very thick, black] (pi) -- (pj);
  \node[anchor=west, inner sep=4pt] at ($(pi)!0.5!(pj)$) {$\ddca$};

  % Distancia requerida
  \draw[target, very thick] (0.5,-1.35) -- ++(1.9,0)
        node[midway, below, inner sep=6pt] {$\Dreq = r_i + r_j + \ds$};
  \draw[target, thick] (0.5,-1.47) -- (0.5,-1.23);
  \draw[target, thick] (2.4,-1.47) -- (2.4,-1.23);

  \node[anchor=north west, align=left, inner sep=0pt] at (5.0,-0.35)
        {\textbf{conflicto} si\\[0.25em]
         $0 < \tdca \le \ta$ \quad y \quad $\ddca < \Dreq$};
\end{tikzpicture}
