% UML del motor de simulacion (solo el motor: nada de post-procesamiento ni de
% figuras), con el mismo dibujo que en los TP3 y TP4: cajas grises, flechas
% rectas y sin rotulos. Experiment arma los eventos desde los datos de la
% catedra, Simulation integra cada evento con Beeman y mide las dos metricas,
% Avoidance decide el target temporal y Model da las fuerzas del SFM sin
% fuerza social.
\begin{tikzpicture}[
    clase/.style={rectangle split, rectangle split parts=2, draw=azul!60,
                  fill=grisclaro, rounded corners=1pt, align=left,
                  font=\scriptsize, text width=3.6cm, inner sep=3pt},
    flecha/.style={-{Latex[length=4pt]}, azul!70}]
    \node[clase] (evt) {\textbf{Event}
        \nodepart{second} \texttt{label, instants}\\ \texttt{left, right}\\ \texttt{minimumDistance}};
    \node[clase, left=0.8cm of evt] (exp) {\textbf{Experiment}
        \nodepart{second} \texttt{framerate, sampling}\\ \texttt{events}\\ \texttt{readExperiment()}};
    \node[clase, right=0.8cm of evt] (ped) {\textbf{Pedestrian}
        \nodepart{second} \texttt{experimental}\\ \texttt{start, initialVelocity}\\ \texttt{target, desiredSpeed}};
    \node[clase, below=0.7cm of evt] (sim) {\textbf{Simulation}
        \nodepart{second} \texttt{simulate()}\\ \texttt{measure()}};
    \node[clase, below=0.7cm of exp] (avo) {\textbf{Avoidance}
        \nodepart{second} \texttt{anticipation, margin}\\ \texttt{temporaryTarget()}};
    \node[clase, below=0.7cm of ped] (mod) {\textbf{Model}
        \nodepart{second} \texttt{mass, radius, relaxation}\\ \texttt{drivingForce()}\\ \texttt{contactForce()}};
    \draw[flecha] (exp) -- (evt);
    \draw[flecha] (evt) -- (ped);
    \draw[flecha] (sim) -- (evt);
    \draw[flecha] (sim) -- (avo);
    \draw[flecha] (sim) -- (mod);
\end{tikzpicture}%
