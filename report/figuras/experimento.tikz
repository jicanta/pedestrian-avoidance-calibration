% El experimento de la catedra: dos filas de personas, una a la izquierda y
% otra abajo a la derecha. En cada prueba sale una de cada fila y las dos se
% cruzan de frente alrededor de y = 2 m. De cada prueba la catedra da las dos
% trayectorias medidas a 15 cuadros por segundo.
\begin{tikzpicture}[scale=0.82, >={Stealth[length=2.2mm]}, font=\footnotesize]
  % Area de seguimiento
  \draw[rounded corners=2pt, fill=grisclaro, draw=gris]
        (0,-0.6) rectangle (11,4.0);
  \node[gris, anchor=north east] at (11,4.0) {área de seguimiento};

  % Fila izquierda
  \foreach \k in {0,1,2} {
    \fill[izquierda!35] (0.7,-0.2-0.55*\k) circle (0.2);
  }
  \node[izquierda, anchor=north] at (0.7,-0.75-1.1) {fila izquierda};

  % Fila derecha (abajo a la derecha)
  \foreach \k in {0,1,2} {
    \fill[derecha!35] (8.1,-0.2-0.55*\k) circle (0.2);
  }
  \node[derecha, anchor=north] at (8.1,-0.75-1.1) {fila derecha};

  % Las dos trayectorias de una prueba
  \draw[izquierda, very thick, ->]
        (0.7,0.3) .. controls (1.2,1.6) and (2.6,1.8) .. (4.0,1.72)
        .. controls (6.0,1.62) and (8.0,1.95) .. (10.3,2.1);
  \draw[derecha, very thick, ->]
        (8.1,0.3) .. controls (8.4,1.5) and (7.2,2.1) .. (5.6,2.28)
        .. controls (4.2,2.44) and (2.0,2.2) .. (0.4,2.08);

  % Discos en el cruce
  \fill[izquierda] (4.55,1.56) circle (0.26);
  \fill[derecha]   (4.55,2.52) circle (0.26);
  \draw[<->, thick] (4.55,1.82) -- (4.55,2.26)
        node[midway, right=3pt, black] {$d_{\min}$};
  \node[anchor=south, black] at (4.55,2.86) {cruce, $y \approx \SI{2}{\meter}$};

  % Ejes
  \draw[->, gris] (0,-0.6) -- (0,4.0) node[anchor=south east] {$y$};
  \draw[->, gris] (0,-0.6) -- (11,-0.6) node[anchor=north east] {$x$};
\end{tikzpicture}
